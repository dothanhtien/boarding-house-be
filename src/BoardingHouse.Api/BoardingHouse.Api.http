@HostAddress = https://localhost:7108

### Register
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "phone": "0123456789",
  "fullName": "Test User",
  "password": "P@ssw0rd!",
  "passwordConfirmation": "P@ssw0rd!"
}

###

# accessToken + refreshToken are now both set as HttpOnly cookies on the login response.
# Enable "rest-client.enableCookies": true in VS Code settings so the requests below send them automatically.
# @name login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "P@ssw0rd!"
}

###

POST {{HostAddress}}/api/auth/refresh-token

###

POST {{HostAddress}}/api/auth/logout

###

### Get current user
GET {{HostAddress}}/api/auth/me
Accept: application/json

###

### Get all users
GET {{HostAddress}}/api/users?page=1&pageSize=20
Accept: application/json

###

# @name createUser
POST {{HostAddress}}/api/users
Content-Type: application/json

{
  "email": "new.user@example.com",
  "phone": "0987654320",
  "fullName": "New User",
  "password": "P@ssw0rd!",
  "passwordConfirmation": "P@ssw0rd!"
}

###

@userId = {{createUser.response.body.id}}

### Get user by id
GET {{HostAddress}}/api/users/{{userId}}
Accept: application/json

###

### Update user
PUT {{HostAddress}}/api/users/{{userId}}
Content-Type: application/json

{
  "phone": "0987654321",
  "fullName": "New User Updated",
  "isActive": true
}

###

### Delete user
DELETE {{HostAddress}}/api/users/{{userId}}

###

### Get all roles
GET {{HostAddress}}/api/roles
Accept: application/json

###

### Get all organizations
GET {{HostAddress}}/api/organizations?page=1&pageSize=20
Accept: application/json

###

# @name createOrganization
POST {{HostAddress}}/api/organizations
Content-Type: application/json

{
  "name": "Sunrise Boarding House",
  "taxCode": "0312345678",
  "phone": "0987654321",
  "email": "contact@sunrise.example.com",
  "province": "Ho Chi Minh",
  "district": "District 1",
  "ward": "Ben Nghe",
  "address": "123 Le Loi"
}

###

@organizationId = {{createOrganization.response.body.id}}

### Get organization by id
GET {{HostAddress}}/api/organizations/{{organizationId}}
Accept: application/json

###

### Update organization
PUT {{HostAddress}}/api/organizations/{{organizationId}}
Content-Type: application/json

{
  "name": "Sunrise Boarding House Updated",
  "taxCode": "0312345678",
  "phone": "0987654321",
  "email": "contact@sunrise.example.com",
  "province": "Ho Chi Minh",
  "district": "District 1",
  "ward": "Ben Nghe",
  "address": "123 Le Loi",
  "isActive": true
}

###

### Delete organization
DELETE {{HostAddress}}/api/organizations/{{organizationId}}

###

### Get organization settings
GET {{HostAddress}}/api/organizations/{{organizationId}}/settings
Accept: application/json

###

### Update organization settings
PUT {{HostAddress}}/api/organizations/{{organizationId}}/settings
Content-Type: application/json

{
  "defaultBillingDay": 5,
  "lateFeeType": "Fixed",
  "lateFeeValue": 50000,
  "lateFeeGraceDays": 3,
  "vatRate": 8,
  "bankAccountNumber": "0123456789",
  "bankName": "Vietcombank",
  "bankAccountName": "SUNRISE BOARDING HOUSE"
}

###
